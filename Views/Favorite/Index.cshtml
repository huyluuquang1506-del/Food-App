@model IEnumerable<Web_Food_App.Models.FoodDetail>

@{
    ViewBag.Title = "Món yêu thích";
}

<h4 class="font-weight-bold text-dark mb-4">
    <i class="fas fa-heart text-primary mr-2"></i> Món yêu thích
</h4>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5 shadow-sm">
        <i class="far fa-heart fa-3x mb-3 text-muted"></i>
        <h5>Bạn chưa lưu món nào.</h5>
        <p class="text-muted mb-0">Bấm "Yêu thích" ở trang chi tiết món để lưu lại tại đây.</p>
        <a href="@Url.Action("Products", "Home")" class="btn btn-primary mt-3">Xem thực đơn</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                @Html.Partial("_FoodCard", item)
            </div>
        }
    </div>
}
