@{
    ViewBag.Title = "Đăng nhập";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 my-4">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="font-weight-bold mb-0"><i class="fas fa-sign-in-alt mr-2"></i>Đăng nhập</h4>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-circle mr-1"></i> @ViewBag.Error
                    </div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="form-group">
                        <label class="font-weight-bold" for="username">Tài khoản</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                            </div>
                            <input type="text" id="username" name="username" class="form-control" placeholder="Tên tài khoản" required autofocus />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" for="password">Mật khẩu</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            </div>
                            <input type="password" id="password" name="password" class="form-control" placeholder="Mật khẩu" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block font-weight-bold py-2 mt-4 shadow-sm">
                        Đăng nhập
                    </button>
                }
            </div>
            <div class="card-footer bg-light text-center py-3">
                <span class="text-muted">Chưa có tài khoản? </span>
                <a href="@Url.Action("Register", "Account")" class="font-weight-bold">Đăng ký ngay</a>
            </div>
        </div>
    </div>
</div>
