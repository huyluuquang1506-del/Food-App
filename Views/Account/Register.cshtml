@model Web_Food_App.Models.RegisterViewModel

@{
    ViewBag.Title = "Đăng ký";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 my-4">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="font-weight-bold mb-0"><i class="fas fa-user-plus mr-2"></i>Đăng ký tài khoản</h4>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="font-weight-bold" for="Username">Tên tài khoản *</label>
                        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autofocus = "autofocus", placeholder = "Ví dụ: nguyenvana" })
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" for="FullName">Họ và tên *</label>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-7">
                            <label class="font-weight-bold" for="Email">Email *</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>
                        <div class="form-group col-md-5">
                            <label class="font-weight-bold" for="Phone">Số điện thoại</label>
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", type = "tel" })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" for="Address">Địa chỉ giao hàng mặc định</label>
                        @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold" for="Password">Mật khẩu *</label>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold" for="ConfirmPassword">Nhập lại mật khẩu *</label>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block font-weight-bold py-2 mt-3 shadow-sm">
                        Tạo tài khoản
                    </button>
                }
            </div>
            <div class="card-footer bg-light text-center py-3">
                <span class="text-muted">Đã có tài khoản? </span>
                <a href="@Url.Action("Login", "Account")" class="font-weight-bold">Đăng nhập</a>
            </div>
        </div>
    </div>
</div>
