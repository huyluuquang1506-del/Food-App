@model Web_Food_App.Models.ChangePasswordViewModel

@{
    ViewBag.Title = "Đổi mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        @Html.Partial("_AccountNav")

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white font-weight-bold">Đổi mật khẩu</div>
            <div class="card-body">
                @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="font-weight-bold" for="CurrentPassword">Mật khẩu hiện tại *</label>
                        @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", autocomplete = "current-password" })
                        @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold" for="NewPassword">Mật khẩu mới *</label>
                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", autocomplete = "new-password" })
                            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold" for="ConfirmNewPassword">Nhập lại mật khẩu mới *</label>
                            @Html.PasswordFor(m => m.ConfirmNewPassword, new { @class = "form-control", autocomplete = "new-password" })
                            @Html.ValidationMessageFor(m => m.ConfirmNewPassword, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                }
            </div>
        </div>
    </div>
</div>
