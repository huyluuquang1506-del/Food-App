@model IEnumerable<Web_Food_App.Models.AppUser>

@{
    ViewBag.Title = "Quản trị - Người dùng";
    var orderCounts = (Dictionary<int, int>)ViewBag.OrderCounts;
}

@Html.Partial("_AdminNav")

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="thead-light">
                <tr>
                    <th>#</th>
                    <th>Tài khoản</th>
                    <th>Họ tên</th>
                    <th>Liên hệ</th>
                    <th>Vai trò</th>
                    <th>Ngày tạo</th>
                    <th class="text-center">Số đơn</th>
                    <th class="text-center">Trạng thái</th>
                    <th style="width: 110px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    int count;
                    orderCounts.TryGetValue(u.UserId, out count);
                    <tr class="@(u.IsActive ? "" : "text-muted")">
                        <td>@u.UserId</td>
                        <td class="font-weight-bold">@u.Username</td>
                        <td>@u.FullName</td>
                        <td class="small">@u.Email<div class="text-muted">@u.Phone</div></td>
                        <td>
                            @if (u.Role == "Admin")
                            {
                                <span class="badge badge-dark">Quản trị</span>
                            }
                            else
                            {
                                <span class="badge badge-light border">Khách hàng</span>
                            }
                        </td>
                        <td class="small">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">@count</td>
                        <td class="text-center">
                            @if (u.IsActive)
                            {
                                <span class="badge badge-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Đã khóa</span>
                            }
                        </td>
                        <td class="text-right">
                            @if (u.Role != "Admin")
                            {
                                using (Html.BeginForm("ToggleUser", "Admin", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.UserId" />
                                    <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(u.IsActive ? "Khóa" : "Mở khóa")
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
