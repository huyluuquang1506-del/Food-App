@model IEnumerable<Web_Food_App.Models.Order>

@{
    ViewBag.Title = "Quản trị - Đơn hàng";
    string currentStatus = ViewBag.Status as string;
}

@Html.Partial("_AdminNav")

@* Lọc theo trạng thái *@
<div class="mb-3">
    <a href="@Url.Action("Orders", "Admin")" class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-dark" : "btn-outline-dark")">Tất cả</a>
    @foreach (var s in ViewHelper.AllStatuses)
    {
        <a href="@Url.Action("Orders", "Admin", new { status = s })" class="btn btn-sm @(currentStatus == s ? "btn-dark" : "btn-outline-dark")">@ViewHelper.StatusText(s)</a>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="thead-light">
                <tr>
                    <th>Đơn</th>
                    <th>Ngày đặt</th>
                    <th>Khách hàng</th>
                    <th>Giao đến</th>
                    <th class="text-center">Số món</th>
                    <th class="text-right">Thành tiền</th>
                    <th class="text-center">Trạng thái</th>
                    <th style="width: 230px;">Chuyển trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-muted text-center py-4">Không có đơn hàng nào.</td></tr>
                }
                @foreach (var o in Model)
                {
                    var next = ViewHelper.NextStatuses(o.Status).ToList();
                    <tr>
                        <td class="font-weight-bold">#@o.OrderId</td>
                        <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@o.User.FullName<div class="small text-muted">@o.User.Phone</div></td>
                        <td class="small">@o.ShippingAddress<div class="text-muted">@ViewHelper.PaymentText(o.PaymentMethod)</div></td>
                        <td class="text-center">
                            <a href="#@("od-" + o.OrderId)" data-toggle="collapse" class="small" aria-expanded="false" title="Xem các món trong đơn">
                                @o.OrderDetails.Sum(d => d.Quantity) <i class="fas fa-chevron-down"></i>
                            </a>
                        </td>
                        <td class="text-right price">@ViewHelper.Money(o.FinalAmount)</td>
                        <td class="text-center"><span class="badge @ViewHelper.StatusBadge(o.Status)">@ViewHelper.StatusText(o.Status)</span></td>
                        <td>
                            @if (next.Count == 0)
                            {
                                <span class="text-muted small">Đã kết thúc</span>
                            }
                            else
                            {
                                using (Html.BeginForm("UpdateOrderStatus", "Admin", FormMethod.Post, new { @class = "form-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@o.OrderId" />
                                    <input type="hidden" name="filter" value="@currentStatus" />
                                    <select name="status" class="form-control form-control-sm mr-1" aria-label="Trạng thái mới">
                                        @foreach (var n in next)
                                        {
                                            <option value="@n">@ViewHelper.StatusText(n)</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Cập nhật</button>
                                }
                            }
                        </td>
                    </tr>
                    <tr>
                        <td colspan="8" class="p-0 border-top-0">
                            <div class="collapse" id="@("od-" + o.OrderId)">
                                <div class="bg-light px-4 py-3 small">
                                    @foreach (var d in o.OrderDetails)
                                    {
                                        <div class="d-flex justify-content-between">
                                            <span>
                                                @d.Food.FoodName <span class="text-muted">&times; @d.Quantity</span>
                                                @if (!string.IsNullOrWhiteSpace(d.Note))
                                                {
                                                    <em class="text-muted"> – @d.Note</em>
                                                }
                                            </span>
                                            <span>@ViewHelper.Money(d.LineTotal)</span>
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between text-muted border-top mt-2 pt-2">
                                        <span>Tiền món @ViewHelper.Money(o.TotalAmount) + giao hàng @ViewHelper.Money(o.ShippingFee)@(o.DiscountAmount > 0 ? " − giảm " + ViewHelper.Money(o.DiscountAmount) : "")</span>
                                        <strong class="text-dark">@ViewHelper.Money(o.FinalAmount)</strong>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
