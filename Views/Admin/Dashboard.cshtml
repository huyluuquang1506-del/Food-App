@model Web_Food_App.Models.DashboardViewModel

@{
    ViewBag.Title = "Quản trị - Tổng quan";
    decimal maxRevenue = Model.Monthly.Any() ? Model.Monthly.Max(m => m.Revenue) : 0m;
}

@Html.Partial("_AdminNav")

@* Số liệu nhanh *@
<div class="row mb-4">
    <div class="col-6 col-lg-3 mb-3">
        <div class="card shadow-sm border-0 h-100"><div class="card-body">
            <div class="text-muted small">Khách hàng</div>
            <div class="h3 font-weight-bold mb-0">@Model.TotalUsers</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card shadow-sm border-0 h-100"><div class="card-body">
            <div class="text-muted small">Tổng số đơn</div>
            <div class="h3 font-weight-bold mb-0">@Model.TotalOrders</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card shadow-sm border-0 h-100"><div class="card-body">
            <div class="text-muted small">Đơn chờ xác nhận</div>
            <div class="h3 font-weight-bold mb-0">
                @Model.PendingOrders
                @if (Model.PendingOrders > 0)
                {
                    <a href="@Url.Action("Orders", "Admin", new { status = "Pending" })" class="btn btn-sm btn-outline-primary ml-2">Xử lý</a>
                }
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card shadow-sm border-0 h-100"><div class="card-body">
            <div class="text-muted small">Doanh thu (đơn hoàn thành)</div>
            <div class="h4 font-weight-bold price mb-0">@ViewHelper.Money(Model.TotalRevenue)</div>
        </div></div>
    </div>
</div>

<div class="row">
    @* Doanh thu theo tháng *@
    <div class="col-lg-7 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white font-weight-bold">Doanh thu tiền món theo tháng</div>
            <div class="card-body">
                @if (!Model.Monthly.Any())
                {
                    <p class="text-muted mb-0">Chưa có đơn hoàn thành nào.</p>
                }
                else
                {
                    foreach (var m in Model.Monthly)
                    {
                        int pct = maxRevenue > 0 ? (int)Math.Round((double)(m.Revenue / maxRevenue) * 100) : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small">
                                <span>Tháng @m.Month/@m.Year</span>
                                <span class="font-weight-bold">@ViewHelper.Money(m.Revenue)</span>
                            </div>
                            <div class="bar-track"><div class="bar-fill" style="width: @(pct)%;"></div></div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* Top 5 món bán chạy *@
    <div class="col-lg-5 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white font-weight-bold">Top 5 món bán chạy</div>
            <ul class="list-group list-group-flush">
                @if (!Model.TopFoods.Any())
                {
                    <li class="list-group-item text-muted">Chưa có dữ liệu.</li>
                }
                @foreach (var t in Model.TopFoods)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@t.FoodName</span>
                        <span class="font-weight-bold">@t.Quantity phần</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@* Lịch sử đổi giá *@
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white font-weight-bold">Thay đổi giá gần đây</div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead class="thead-light">
                <tr><th>Thời điểm</th><th>Món</th><th class="text-right">Giá cũ</th><th class="text-right">Giá mới</th></tr>
            </thead>
            <tbody>
                @if (!Model.PriceChanges.Any())
                {
                    <tr><td colspan="4" class="text-muted">Chưa có thay đổi giá nào.</td></tr>
                }
                @foreach (var p in Model.PriceChanges)
                {
                    <tr>
                        <td>@p.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@p.Food.FoodName</td>
                        <td class="text-right">@ViewHelper.Money(p.OldPrice)</td>
                        <td class="text-right font-weight-bold">@ViewHelper.Money(p.NewPrice)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
