@model Web_Food_App.Models.Food

@{
    ViewBag.Title = "Quản trị - " + ViewBag.FormTitle;
    bool isEdit = Model.FoodId > 0;
}

@Html.Partial("_AdminNav")

<div class="card shadow-sm border-0">
    <div class="card-header bg-white font-weight-bold">@ViewBag.FormTitle</div>
    <div class="card-body">
        @using (Html.BeginForm(isEdit ? "EditFood" : "CreateFood", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            if (isEdit)
            {
                @Html.HiddenFor(m => m.FoodId)
            }

            <div class="form-group">
                <label class="font-weight-bold" for="FoodName">Tên món *</label>
                @Html.TextBoxFor(m => m.FoodName, new { @class = "form-control", maxlength = 150 })
                @Html.ValidationMessageFor(m => m.FoodName, "", new { @class = "text-danger small" })
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label class="font-weight-bold" for="CategoryId">Nhóm món *</label>
                    @Html.DropDownListFor(m => m.CategoryId, (SelectList)ViewBag.Categories, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-6">
                    <label class="font-weight-bold" for="RestaurantId">Quán *</label>
                    @Html.DropDownListFor(m => m.RestaurantId, (SelectList)ViewBag.Restaurants, new { @class = "form-control" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label class="font-weight-bold" for="Price">Giá (đ) *</label>
                    @Html.TextBoxFor(m => m.Price, "{0:0}", new { @class = "form-control", type = "number", min = 0, step = 1000 })
                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger small" })
                </div>
                <div class="form-group col-md-6">
                    <label class="font-weight-bold" for="Stock">Tồn kho *</label>
                    @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number", min = 0 })
                    @Html.ValidationMessageFor(m => m.Stock, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="form-group">
                <label class="font-weight-bold" for="ImageUrl">Đường dẫn ảnh</label>
                @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control", placeholder = "/Content/img/ten-anh.jpg" })
                @Html.ValidationMessageFor(m => m.ImageUrl, "", new { @class = "text-danger small" })
            </div>

            <div class="form-group">
                <label class="font-weight-bold" for="Description">Mô tả</label>
                @Html.TextAreaFor(m => m.Description, 3, 40, new { @class = "form-control" })
            </div>

            <div class="form-group form-check">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                <label class="form-check-label" for="IsActive">Đang bán</label>
            </div>

            <div class="d-flex justify-content-between">
                <a href="@Url.Action("Foods", "Admin")" class="btn btn-outline-secondary">Hủy</a>
                <button type="submit" class="btn btn-primary">@(isEdit ? "Lưu thay đổi" : "Thêm món")</button>
            </div>
        }
    </div>
</div>
