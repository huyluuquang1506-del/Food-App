@model Web_Food_App.Models.FoodDetailsViewModel

@{
    var food = Model.Food;
    bool loggedIn = Session["UserId"] != null;
    int myRating = Model.MyReview != null ? Model.MyReview.Rating : 0;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-white shadow-sm">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Products", "Home", new { categoryId = food.CategoryId })">@food.Category.CategoryName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@food.FoodName</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="row">
            @* Ảnh món *@
            <div class="col-md-5 mb-3 mb-md-0">
                <div class="food-thumb food-thumb-lg">
                    <i class="fas fa-utensils food-thumb-icon"></i>
                    @if (!string.IsNullOrEmpty(food.ImageUrl))
                    {
                      <img src="@Url.Content(ViewHelper.ImagePath(food.ImageUrl))" alt="@food.FoodName" class="food-detail-img" />
                    }
                </div>
            </div>

            @* Thông tin món *@
            <div class="col-md-7">
                <h3 class="font-weight-bold mb-2">@food.FoodName</h3>

                <div class="mb-2">
                    @if (Model.Reviews.Count > 0)
                    {
                        <span class="rating-stars"><i class="fas fa-star"></i> @string.Format("{0:0.0}", Model.AvgRating)</span>
                        <span class="text-muted">(@Model.Reviews.Count đánh giá)</span>
                    }
                    else
                    {
                        <span class="text-muted">Chưa có đánh giá</span>
                    }
                </div>

                <p class="text-muted mb-1"><i class="fas fa-store mr-2"></i>@food.Restaurant.RestaurantName &middot; @food.Restaurant.Address</p>
                <p class="text-muted mb-3">
                    <i class="far fa-clock mr-2"></i>Mở cửa @ViewHelper.Time(food.Restaurant.OpenTime) – @ViewHelper.Time(food.Restaurant.CloseTime)
                </p>

                <div class="price mb-3" style="font-size: 1.8rem;">@ViewHelper.Money(food.Price)</div>

                @if (!string.IsNullOrWhiteSpace(food.Description))
                {
                    <p>@food.Description</p>
                }

                <p class="mb-3">
                    @if (food.Stock > 0)
                    {
                        <span class="badge badge-success">Còn @food.Stock phần</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">Hết hàng</span>
                    }
                </p>

                <div class="d-flex flex-wrap align-items-center">
                    @if (food.Stock > 0)
                    {
                        using (Html.BeginForm("Add", "Cart", FormMethod.Post, new { @class = "form-inline mr-3 mb-2" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@food.FoodId" />
                            <label class="mr-2 font-weight-bold" for="quantity">Số lượng</label>
                            <input type="number" id="quantity" name="quantity" value="1" min="1" max="@food.Stock" class="form-control qty-input mr-2" />
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-cart-plus mr-1"></i> Thêm vào giỏ
                            </button>
                        }
                    }

                    @* Yêu thích *@
                    @if (loggedIn)
                    {
                        using (Html.BeginForm("Toggle", "Favorite", FormMethod.Post, new { @class = "mb-2" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="foodId" value="@food.FoodId" />
                            <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="@(Model.IsFavorite ? "fas" : "far") fa-heart mr-1"></i>
                                @(Model.IsFavorite ? "Bỏ yêu thích" : "Yêu thích")
                            </button>
                        }
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl })" class="btn btn-outline-primary mb-2">
                            <i class="far fa-heart mr-1"></i> Đăng nhập để yêu thích
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* Đánh giá *@
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white font-weight-bold">
        <i class="fas fa-comments text-primary mr-2"></i> Đánh giá của khách hàng
    </div>
    <div class="card-body">
        @if (loggedIn)
        {
            using (Html.BeginForm("AddReview", "Food", FormMethod.Post, new { @class = "mb-4 pb-4 border-bottom" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="foodId" value="@food.FoodId" />

                <h6 class="font-weight-bold">@(Model.MyReview != null ? "Sửa đánh giá của bạn" : "Viết đánh giá")</h6>

                <div class="star-input mb-2" role="radiogroup" aria-label="Chọn số sao">
                    @for (int s = 5; s >= 1; s--)
                    {
                        <input type="radio" id="@("star" + s)" name="rating" value="@s" @(myRating == s ? "checked" : "") required />
                        <label for="@("star" + s)" title="@(s) sao"><i class="fas fa-star"></i></label>
                    }
                </div>

                <div class="form-group">
                    <textarea name="comment" class="form-control" rows="3" maxlength="500" placeholder="Món này thế nào? (không bắt buộc)">@(Model.MyReview != null ? Model.MyReview.Comment : "")</textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-sm">Gửi đánh giá</button>
            }
        }
        else
        {
            <p class="text-muted">
                <a href="@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl })">Đăng nhập</a> để viết đánh giá cho món này.
            </p>
        }

        @if (Model.Reviews.Count == 0)
        {
            <p class="text-muted mb-0">Chưa có đánh giá nào. Hãy là người đầu tiên!</p>
        }
        else
        {
            foreach (var r in Model.Reviews)
            {
                <div class="media mb-3">
                    <i class="fas fa-user-circle fa-2x text-secondary mr-3"></i>
                    <div class="media-body">
                        <div>
                            <strong>@r.User.FullName</strong>
                            <small class="text-muted ml-2">@r.CreatedAt.ToString("dd/MM/yyyy")</small>
                        </div>
                        <div class="rating-stars small mb-1">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="@(i <= r.Rating ? "fas" : "far") fa-star"></i>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.Comment))
                        {
                            <div>@r.Comment</div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@* Món cùng nhóm *@
@if (Model.Related.Any())
{
    <h5 class="font-weight-bold mb-3">Món cùng nhóm</h5>
    <div class="row">
        @foreach (var item in Model.Related)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                @Html.Partial("_FoodCard", item)
            </div>
        }
    </div>
}
