@model IEnumerable<Web_Food_App.Models.Category>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white font-weight-bold">
        <i class="fas fa-bars mr-1"></i> Nhóm món
    </div>
    <div class="list-group list-group-flush">
        <a href="@Url.Action("Products", "Home")" class="list-group-item list-group-item-action">
            Tất cả món
        </a>
        @foreach (var item in Model)
        {
            <a href="@Url.Action("Products", "Home", new { categoryId = item.CategoryId })"
               class="list-group-item list-group-item-action">
                @item.CategoryName
            </a>
        }
    </div>
</div>
